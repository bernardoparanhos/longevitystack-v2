---
import Base from './Base.astro';
import EvidencePanel from '../components/EvidencePanel.astro';
import ProductCard from '../components/ProductCard.astro';

interface Heading { slug: string; text: string; }
interface RecommendedProduct { name: string; brand: string; price: number; affiliateUrl: string; disclosure: string; }
interface Props {
  title: string;
  tagline: string;
  canonicalPath: string;
  lastReviewed?: Date;
  references?: number;
  participants?: number;
  headings: Heading[];
  recommendedProduct?: RecommendedProduct;
}
const { title, tagline, canonicalPath, lastReviewed, references, participants, headings, recommendedProduct } = Astro.props as Props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: tagline,
  author: { '@type': 'Person', name: 'Bernardo Paranhos', affiliation: { '@type': 'CollegeOrUniversity', name: 'UTFPR' } },
  dateModified: lastReviewed ? lastReviewed.toISOString() : undefined,
};
---
<Base title={title} description={tagline} current="compounds" canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <main class="ls-shell">
    <div style="padding: 64px 0 0; max-width: 900px;">
      <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px;">
        <span class="ls-kicker">Compound</span>
        <span style="width: 120px; height: 3px; background: linear-gradient(90deg, var(--color-accent-700) 0%, var(--color-accent-400) 55%, var(--color-neutral-400) 100%);"></span>
      </div>
      <h1 style="font-family: var(--font-heading); font-weight: 600; font-size: 48px; line-height: 1.1; letter-spacing: -0.015em; margin: 0 0 16px;">{title}</h1>
      <p style="font-size: 18px; line-height: 1.55; max-width: 62ch; margin: 0 0 20px;" class="ls-muted">{tagline}</p>
      <div style="display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 13px; padding-bottom: 28px; border-bottom: 1px solid var(--color-divider);" class="ls-muted ls-tabular">
        <span>Bernardo Paranhos</span><span>·</span>
        {lastReviewed ? <span style="color: var(--color-accent-700);">Last reviewed {lastReviewed.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}</span> : <span>Review pending</span>}
      </div>
    </div>

    <div class="ls-article-grid">
      <aside class="ls-sidebar">
        <div style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 16px;" class="ls-muted">Contents</div>
        <nav class="ls-toc">
          {headings.map((h) => <a href={'#' + h.slug}>{h.text}</a>)}
          {recommendedProduct && <a href="#recommended-product">Recommended product</a>}
        </nav>
      </aside>

      <article class="ls-article">
        <slot />
        {recommendedProduct && (
          <>
            <h2 id="recommended-product">Recommended product</h2>
            <ProductCard
              kicker="Recommended product"
              name={recommendedProduct.name + ' — ' + recommendedProduct.brand}
              description={'$' + recommendedProduct.price.toLocaleString('en-US')}
              ctaHref={recommendedProduct.affiliateUrl}
              ctaLabel="Check current price"
              disclosure={recommendedProduct.disclosure}
            />
          </>
        )}
      </article>

      <EvidencePanel references={references} participants={participants} />
    </div>
  </main>
</Base>
