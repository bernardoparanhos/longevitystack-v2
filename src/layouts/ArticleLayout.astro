---
// Shared by Understand and Protocols detail pages: a sticky table-of-contents
// rail, the MDX body, and a sticky evidence-summary panel on the right.
import Base from './Base.astro';
import EvidencePanel from '../components/EvidencePanel.astro';

interface Heading { slug: string; text: string; }
interface Composition { metaAnalyses: number; rcts: number; crossover: number; observational: number; }
interface Props {
  title: string;
  description: string;
  pillar: 'Understand' | 'Protocol';
  current: string;
  canonicalPath: string;
  lastReviewed?: Date;
  references?: number;
  participants?: number;
  studyComposition?: Composition;
  headings: Heading[];
  readingTime?: string;
}
const {
  title, description, pillar, current, canonicalPath,
  lastReviewed, references, participants, studyComposition, headings, readingTime,
} = Astro.props as Props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: { '@type': 'Person', name: 'Bernardo Paranhos', affiliation: { '@type': 'CollegeOrUniversity', name: 'UTFPR' } },
  dateModified: lastReviewed ? lastReviewed.toISOString() : undefined,
};
---
<Base title={title} description={description} current={current === 'Protocol' ? 'protocols' : 'understand'} canonicalPath={canonicalPath} jsonLd={jsonLd}>
  <main class="ls-shell">
    <div style="padding: 64px 0 0; max-width: 900px;">
      <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px;">
        <span class="ls-kicker">{pillar}</span>
        <span style="width: 120px; height: 3px; background: linear-gradient(90deg, var(--color-accent-700) 0%, var(--color-accent-400) 55%, var(--color-neutral-400) 100%);"></span>
      </div>
      <h1 style="font-family: var(--font-heading); font-weight: 600; font-size: 52px; line-height: 1.08; letter-spacing: -0.015em; margin: 0 0 24px;">{title}</h1>
      <p style="font-size: 20px; line-height: 1.55; max-width: 62ch; margin: 0 0 28px;" class="ls-muted">{description}</p>
      <div style="display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 13px; padding-bottom: 28px; border-bottom: 1px solid var(--color-divider);" class="ls-muted ls-tabular">
        <span>Bernardo Paranhos</span>
        <span>·</span>
        {lastReviewed ? <span style="color: var(--color-accent-700);">Last reviewed {lastReviewed.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}</span> : <span>Review pending</span>}
        {readingTime && <><span>·</span><span>{readingTime}</span></>}
        {references !== undefined && <><span>·</span><span>{references} references{participants !== undefined ? ' · ' + participants.toLocaleString('en-US') + ' participants' : ''}</span></>}
      </div>
    </div>

    <div class="ls-article-grid">
      <aside class="ls-sidebar">
        <div style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 16px;" class="ls-muted">Contents</div>
        <nav class="ls-toc">
          {headings.map((h) => <a href={'#' + h.slug}>{h.text}</a>)}
        </nav>
      </aside>

      <article class="ls-article">
        <slot />
      </article>

      <EvidencePanel references={references} participants={participants} composition={studyComposition} />
    </div>
  </main>
</Base>
