---
// One claim in an evidence section: the claim, then its study metadata as a
// real <table> row (studyType/sampleSize/population/funding), the result,
// citation link, and a 5-step strength indicator (1 = weakest, 5 = strongest).
interface Props {
  number: string;
  claim: string;
  studyType: string;
  sampleSize: string;
  population: string;
  funding: string;
  result: string;
  citationHref?: string;
  citationLabel?: string;
  strength: 1 | 2 | 3 | 4 | 5;
}
const { number, claim, studyType, sampleSize, population, funding, result, citationHref = '#', citationLabel = '[1]', strength } = Astro.props as Props;
const steps = [1, 2, 3, 4, 5];
function tone(step: number) {
  if (step > strength) return '';
  if (step === 1) return 'on-strong';
  if (step === 2) return 'on-strong';
  if (step === 3) return 'on-mid';
  return 'on-light';
}
---
<div class="ls-evidence">
  <div class="ls-evidence-head">
    <div style="font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;" class="ls-muted">Evidence · claim {number}</div>
    <div style="display: flex; align-items: center; gap: 8px;">
      <span style="font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;" class="ls-muted">Strength</span>
      <span class="ls-strength">
        {steps.map((s) => <i class={tone(s)}></i>)}
      </span>
    </div>
  </div>
  <p style="margin: 0 0 18px; font-size: 18px; line-height: 1.55;"><strong>{claim}</strong></p>
  <table class="table" style="margin-bottom: 14px;">
    <thead>
      <tr><th>Study type</th><th>Sample</th><th>Population</th><th>Funding</th></tr>
    </thead>
    <tbody>
      <tr><td>{studyType}</td><td class="ls-tabular">{sampleSize}</td><td>{population}</td><td>{funding}</td></tr>
    </tbody>
  </table>
  <p style="margin: 0; font-size: 16px; line-height: 1.55;" class="ls-muted">
    <span style="font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; margin-right: 8px;">Result</span>
    {result} <a href={citationHref}>{citationLabel}</a>
  </p>
</div>
