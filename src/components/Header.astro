---
const { current = '' } = Astro.props as { current?: string };
const links = [
  { href: '/understand/', label: 'Understand', key: 'understand' },
  { href: '/protocols/', label: 'Protocols', key: 'protocols' },
  { href: '/compounds/', label: 'Compounds', key: 'compounds' },
  { href: '/gear/', label: 'Gear', key: 'gear' },
  { href: '/field-notes/', label: 'Field Notes', key: 'field-notes' },
];
---
<div style="height: 3px; width: 100%; background: linear-gradient(90deg, var(--color-accent-900) 0%, var(--color-accent-700) 22%, var(--color-accent-400) 42%, var(--color-neutral-400) 58%, var(--color-accent-2-400) 78%, var(--color-accent-2-700) 100%);"></div>
<header style="position: sticky; top: 0; z-index: 20; background: var(--color-bg); border-bottom: 1px solid var(--color-divider);">
  <div class="ls-shell" style="padding: 18px 40px; display: flex; align-items: flex-end; justify-content: space-between; gap: 40px;">
    <a href="/" style="text-decoration: none; color: inherit; display: block;">
      <div style="font-size: 21px; font-weight: 600; letter-spacing: 0.02em; line-height: 1;">LONGEVITYSTACK</div>
      <div class="ls-muted" style="font-size: 13px; font-style: italic; margin-top: 5px; line-height: 1;">the engineering of sleep</div>
    </a>
    <nav style="display: flex; align-items: center; gap: 26px; padding-bottom: 2px;">
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}
           style={"font-size: 15px; text-decoration: none; padding-bottom: 4px; color: " + (current === l.key ? 'var(--color-accent-700)' : 'var(--color-text)')}>
          {l.label}
        </a>
      ))}
      <a href="/#subscribe" class="btn btn-primary" style="font-size: 14px; padding: 8px 16px; text-decoration: none;">Subscribe</a>
    </nav>
  </div>
</header>
