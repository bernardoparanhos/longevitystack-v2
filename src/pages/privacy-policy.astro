---
import Base from '../layouts/Base.astro';
---
<Base title="Privacy Policy" description="What LongevityStack collects and how it is used." current="privacy-policy" canonicalPath="/privacy-policy/">
  <main class="ls-shell">
    <article style="max-width: 68ch; padding: 64px 0 96px;" class="ls-article">
      <h1 style="font-family: var(--font-heading); font-weight: 600; font-size: 46px; letter-spacing: -0.015em; margin: 0 0 28px;">Privacy Policy</h1>
      <p>This site uses Google Analytics (GA4) to understand aggregate traffic patterns, and Brevo to manage newsletter subscriptions. Email addresses submitted to the newsletter form are used only to send the newsletter and are never sold.</p>
      <div class="ls-pending">TODO: replace with final legal-reviewed privacy policy (cookie categories, GA4 property ID, data-retention terms, GDPR/CCPA contact) before publishing.</div>
    </article>
  </main>
</Base>
