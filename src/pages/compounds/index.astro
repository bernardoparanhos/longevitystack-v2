---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const entries = await getCollection('compounds');
---
<Base title="Compounds" description="What enters the body that affects thermoregulation or sleep architecture. Mechanism, evidence, dosage — and the product, disclosed inline." current="compounds" canonicalPath="/compounds/">
  <main class="ls-shell">
    <div style="padding: 64px 0 48px; max-width: 800px; border-bottom: 1px solid var(--color-divider);">
      <div class="ls-kicker" style="margin-bottom: 20px;">Pillar · Compounds</div>
      <h1 style="font-family: var(--font-heading); font-weight: 600; font-size: 52px; line-height: 1.08; letter-spacing: -0.015em; margin: 0 0 20px;">Compounds</h1>
      <p style="font-size: 19px; line-height: 1.6; margin: 0;" class="ls-muted">What enters the body that affects thermoregulation or sleep architecture. Mechanism, evidence, dosage — and the product, disclosed inline.</p>
    </div>
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; padding: 56px 0 96px;">
      {entries.map((e) => (
        <a href={'/compounds/' + e.id + '/'} style={"text-decoration: none; color: inherit; border-top: 2px solid " + (e.data.draft ? 'var(--color-divider)' : 'var(--color-text)') + "; padding-top: 18px; display: block;"}>
          <div style={"font-family: var(--font-heading); font-size: 22px; font-weight: 600; line-height: 1.2; margin-bottom: 10px;" + (e.data.draft ? ' color: color-mix(in srgb, var(--color-text) 70%, transparent);' : '')}>{e.data.title}</div>
          <p style="margin: 0 0 16px; font-size: 15px; line-height: 1.5;" class="ls-muted">{e.data.tagline}</p>
          <span class={e.data.draft ? 'tag tag-outline' : 'tag tag-accent'} style="font-size: 11px;">{e.data.draft ? 'Not yet written' : 'Full article'}</span>
        </a>
      ))}
    </div>
  </main>
</Base>
