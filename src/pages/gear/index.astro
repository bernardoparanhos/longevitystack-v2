---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GearTable from '../../components/GearTable.astro';
const entries = await getCollection('gear');
const rows = entries.map((e) => ({ name: e.data.title, href: '/gear/' + e.id + '/', bestFor: e.data.bestFor, price: e.data.price, verdict: e.data.verdict }));
---
<Base title="Gear" description="Hardware that controls the ambient environment. Verdict, price and who should not buy — before the affiliate link." current="gear" canonicalPath="/gear/">
  <main class="ls-shell">
    <div style="padding: 64px 0 48px; max-width: 800px; border-bottom: 1px solid var(--color-divider);">
      <div class="ls-kicker" style="margin-bottom: 20px; color: var(--color-accent-2-700);">Pillar · Gear</div>
      <h1 style="font-family: var(--font-heading); font-weight: 600; font-size: 52px; line-height: 1.08; letter-spacing: -0.015em; margin: 0 0 20px;">Gear</h1>
      <p style="font-size: 19px; line-height: 1.6; margin: 0;" class="ls-muted">Hardware that controls the ambient environment. Verdict, price and who should not buy — before the affiliate link.</p>
    </div>
    <div style="padding: 48px 0 96px;">
      <GearTable rows={rows} />
    </div>
  </main>
</Base>
